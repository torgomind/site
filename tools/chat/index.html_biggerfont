<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Chatroom | TORGOMIND</title>
	<meta name="description" content="An anonymous live 24/7 chatroom from TORGOMIND.">
	<link rel="stylesheet" href="../../assets/css/style.css">
	<script>if (new URLSearchParams(window.location.search).has("embed")) { document.documentElement.classList.add("embed"); }</script>
	<style>
		@font-face {
			font-family: 'Filgaia';
			src: url('../../assets/fonts/filgaia.ttf') format('truetype');
			font-weight: normal;
			font-style: normal;
		}

		body {
			background-color: #020a04;
			background-image: url('slimebg.gif');
			background-repeat: repeat;
			background-position: center top;
			background-size: 400px;
			background-attachment: fixed;
			image-rendering: pixelated;
			font-family: 'Courier New', Courier, monospace;
		}

		.chat-wrapper {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: 2rem 1rem 3rem;
		}

		.chat-header {
			text-align: center;
			margin: 1.5rem 0 1rem;
			padding: 0.9rem 1.6rem 0.8rem;
			font-family: 'Filgaia', monospace;
			background-color: rgba(8, 0, 0, 0.92);
			border: 1px solid var(--color-primary-dark);
			border-radius: 5px;
			box-shadow: 0 0 18px rgba(0, 0, 0, 0.9);
		}

		.chat-header h1 {
			font-size: 2rem;
			font-weight: normal;
			line-height: 1;
			color: var(--color-text-light);
			letter-spacing: 0.15em;
			text-shadow: 0 0 10px rgba(192, 80, 80, 0.7);
		}

		.chat-subtitle {
			margin-top: 0.4rem;
			font-size: 1.1rem;
			line-height: 1;
			color: var(--color-primary);
			letter-spacing: 0.1em;
		}

		.back-link {
			display: inline-block;
			color: var(--color-primary);
			font-size: 1.2rem;
			text-decoration: none;
			margin-bottom: 1.5rem;
			opacity: 0.7;
			transition: opacity 0.2s ease;
		}

		.back-link:hover {
			opacity: 1;
		}

		.chat-panel {
			width: 100%;
			max-width: 680px;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1rem;
			background-color: rgba(7, 27, 14, 0.8);
			border: 1px solid var(--color-border-card);
			border-radius: 5px;
		}

		#log {
			height: 55vh;
			min-height: 280px;
			max-height: 620px;
			overflow-y: auto;
			padding: 0.6rem 0.8rem;
			background-color: rgba(0, 0, 0, 0.45);
			border: 1px solid rgba(142, 125, 167, 0.35);
			border-radius: 3px;
			scrollbar-width: thin;
			scrollbar-color: var(--color-primary-dark) transparent;
		}

		#log::-webkit-scrollbar {
			width: 8px;
		}

		#log::-webkit-scrollbar-thumb {
			background-color: var(--color-primary-dark);
			border-radius: 4px;
		}

		#log:empty::before {
			content: "the channel is silent.";
			font-size: 1.35rem;
			color: #777;
		}

		.msg {
			font-size: 1.35rem;
			line-height: 1.4;
			color: var(--color-text-light);
			padding: 0.2rem 0 0.2rem 0.6rem;
			border-left: 2px solid transparent;
			overflow-wrap: anywhere;
		}

		.msg.mine {
			border-left-color: var(--color-primary-dark);
			background-color: rgba(133, 58, 58, 0.1);
		}

		.time {
			font-size: 1.05rem;
			color: #777;
			margin-right: 0.5rem;
		}

		.name {
			font-weight: bold;
		}

		.name.admin {
			color: var(--color-primary);
			letter-spacing: 0.08em;
			animation: admin-glow 2.4s ease-in-out infinite;
		}

		.name.admin .wiggle {
			display: inline-block;
			animation: admin-wiggle 1.2s ease-in-out infinite;
		}

		@keyframes admin-wiggle {
			0%, 100% {
				transform: translateY(0) rotate(0deg);
			}
			25% {
				transform: translateY(-3px) rotate(-6deg);
			}
			75% {
				transform: translateY(2px) rotate(6deg);
			}
		}

		@keyframes admin-glow {
			0%, 100% {
				text-shadow: 0 0 4px rgba(192, 80, 80, 0.5);
			}
			50% {
				text-shadow: 0 0 12px rgba(230, 90, 90, 1);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.name.admin,
			.name.admin .wiggle {
				animation: none;
			}
		}

		.msg .name::after {
			content: ":";
			color: #777;
			margin-right: 0.45rem;
		}

		#form {
			display: flex;
			gap: 0.5rem;
		}

		#input {
			flex: 1;
			min-width: 0;
			font-family: inherit;
			font-size: 1.35rem;
			color: var(--color-text-light);
			background-color: rgba(0, 0, 0, 0.45);
			border: 1px solid #444;
			border-radius: 3px;
			padding: 0.5rem 0.7rem;
			outline: none;
			transition: border-color 0.2s ease;
		}

		#input::placeholder {
			color: #777;
		}

		#input:focus {
			border-color: var(--color-primary);
		}

		#send {
			font-family: inherit;
			font-size: 1.35rem;
			font-weight: bold;
			letter-spacing: 0.05em;
			color: var(--color-primary);
			background: none;
			border: 1px solid var(--color-primary-dark);
			border-radius: 3px;
			padding: 0.3rem 1.2rem;
			cursor: pointer;
			transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
		}

		#send:hover:not(:disabled) {
			background-color: rgba(133, 58, 58, 0.25);
			border-color: var(--color-primary);
			color: var(--color-text-light);
		}

		#send:disabled {
			opacity: 0.4;
			cursor: default;
		}

		#status {
			min-height: 1.6em;
			font-size: 1rem;
			color: var(--color-text-body);
		}

		#status.error {
			color: #c05050;
		}

		.chat-note {
			max-width: 680px;
			margin-top: 1rem;
			font-size: 0.95rem;
			color: var(--color-text-body);
			text-align: center;
			opacity: 0.7;
		}

		@media (max-width: 520px) {
			.chat-header h1 {
				font-size: 1.4rem;
			}

			.chat-wrapper {
				padding: 1rem 0.75rem 2rem;
			}

			.chat-panel {
				padding: 0.6rem;
			}

			#log {
				height: 60vh;
			}

			#send {
				padding: 0.3rem 0.8rem;
			}
		}

		.embed body {
			background-size: 120px;
		}

		.embed .chat-header,
		.embed .back-link,
		.embed .chat-note {
			display: none;
		}

		.embed .chat-wrapper {
			min-height: 0;
			height: 100vh;
			padding: 0;
		}

		.embed .chat-panel {
			flex: 1;
			min-height: 0;
			max-width: none;
			gap: 0.5rem;
			padding: 0.5rem;
			border: 0;
			border-radius: 0;
		}

		.embed #log {
			flex: 1;
			height: auto;
			min-height: 0;
			max-height: none;
		}

		.embed .msg,
		.embed #input,
		.embed #send {
			font-size: 1rem;
		}

		.embed #log:empty::before {
			font-size: 1rem;
		}

		.embed .time {
			font-size: 0.8rem;
		}

		.embed #status {
			min-height: 1.2em;
			font-size: 0.85rem;
		}
	</style>
</head>
<body>
	<div class="chat-wrapper">
		<header class="chat-header">
			<h1>TORGOZONE CHATROOM</h1>
			<p class="chat-subtitle">live 24/7 webchat</p>
		</header>

		<a href="../index.html" class="back-link">← tools</a>

		<main class="chat-panel">
			<div id="log"></div>
			<div id="form">
				<input id="input" maxlength="500" autocomplete="off" placeholder="say something">
				<button id="send">send</button>
			</div>
			<div id="status">connecting...</div>
		</main>

		<p class="chat-note">hi.</p>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
	<script src="chat.js"></script>
</body>
</html>
